{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["gitlab>thelabnyc/renovate-config:default"],
    // Run lock file maintenance weekly on Wednesdays
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["before 9am on wednesday"]
    },
    "packageRules": [
        // Pin Node to current LTS version (26.x) and it's default npm version
        {
            "matchDepNames": ["npm"],
            "allowedVersions": "<=11"
        },
        {
            "matchDepNames": ["node.js", "node", "@types/node"],
            "allowedVersions": "<=26",
            "rangeStrategy": "replace"
        },
        // Pin Python to current stable version (3.13)
        {
            "matchPackageNames": ["/python/", "!/^(types-)?python-/"],
            "allowedVersions": "<=3.14",
            "rangeStrategy": "replace"
        },
        // npm semver reads a docker tag suffix (3.14.3459-node24-geospatial)
        // as a prerelease, which never satisfies the ranges above.
        {
            "matchDatasources": ["docker"],
            "matchDepNames": ["node"],
            "allowedVersions": "!/^(2[7-9]|[3-9]\\d)(\\D|$)/"
        },
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["/python/", "!/^(types-)?python-/"],
            "allowedVersions": "!/^3\\.(1[5-9]|[2-9]\\d)(\\D|$)/"
        },
        // Pin Django to current LTS version (5.2 LTS)
        {
            "matchDepNames": ["Django", "django"],
            "allowedVersions": "<5.3"
        },
        // django-stubs 6.x partly supports Django 5.2 and is needed for mypy 2.4+
        {
            "matchDepNames": ["django-stubs", "django-stubs-ext"],
            "allowedVersions": "<7"
        },
        // Pin Wagtail to current version (7.4)
        {
            "matchDepNames": ["wagtail"],
            "allowedVersions": "<7.5"
        }
    ]
}

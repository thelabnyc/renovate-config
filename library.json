{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["gitlab>thelabnyc/renovate-config:default"],
    // Run lock file maintenance weekly on Tuesdays
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["before 9am on tuesday"]
    },
    "packageRules": [
        // Pin Node to current LTS version and it's default npm version
        {
            "matchDepNames": ["npm"],
            "allowedVersions": "<=11"
        },
        {
            "matchDepNames": ["node.js", "node", "@types/node"],
            "allowedVersions": "<=26",
            "rangeStrategy": "replace"
        },
        // Widen only the published engines range to keep old LTS support
        {
            "matchDepNames": ["node"],
            "matchDepTypes": ["engines"],
            "rangeStrategy": "widen"
        },
        // Pin Python to older min-version for broader compatibility
        {
            "matchDepNames": ["python"],
            "allowedVersions": "<=3.12",
            "rangeStrategy": "replace"
        },
        // npm semver reads a docker tag suffix (3.12.12-slim-trixie) as a
        // prerelease, which never satisfies the ranges above.
        {
            "matchDatasources": ["docker"],
            "matchDepNames": ["node"],
            "allowedVersions": "!/^(2[7-9]|[3-9]\\d)(\\D|$)/"
        },
        {
            "matchDatasources": ["docker"],
            "matchDepNames": ["python"],
            "allowedVersions": "!/^3\\.(1[3-9]|[2-9]\\d)(\\D|$)/"
        },
        // Allow Django up to current LTS but widen range to keep old LTS support
        {
            "matchDepNames": ["Django", "django"],
            "allowedVersions": "<5.3",
            "rangeStrategy": "widen"
        },
        // django-stubs 6.x partly supports Django 5.2 and is needed for mypy 2.4+
        {
            "matchDepNames": ["django-stubs", "django-stubs-ext"],
            "allowedVersions": "<7",
            "rangeStrategy": "widen"
        },
        // Allow Wagtail up to current LTS but widen range to keep old LTS support
        {
            "matchDepNames": ["wagtail"],
            "allowedVersions": "<7.5",
            "rangeStrategy": "widen"
        }
    ]
}
